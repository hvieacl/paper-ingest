# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 不在代码里写死模型名；填你当前 API 控制台可用的非思考模型
DEEPSEEK_MODEL=

# ---------- Feishu ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# ---------- Pipeline ----------
# 送入模型的最大字符数。V1 以正文文本为主，不做图像/公式 OCR。
MAX_ANALYSIS_CHARS=120000
# 0=真实写入；1=只生成结果和飞书写入预览，不写表
DRY_RUN=1
