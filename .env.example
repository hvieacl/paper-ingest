# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 填你当前 DeepSeek API 实际可用的模型名
DEEPSEEK_MODEL=
# 结构化分析输出语言。默认简体中文；title 等官方元数据仍保留原文。
ANALYSIS_LANGUAGE=zh-CN
# JSON / 输出语言校验失败时的自动重试次数（不含首次请求）
DEEPSEEK_MAX_RETRIES=2
# 单次结构化输出最大 token 数
DEEPSEEK_MAX_TOKENS=7000
# 1=运行结束后查询余额；0=不查询
QUERY_DEEPSEEK_BALANCE=1

# ---------- Feishu ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# ---------- Pipeline ----------
# 送入模型的最大字符数。V1 以正文文本为主，不做图像/公式 OCR。
MAX_ANALYSIS_CHARS=120000

# 1 = 只分析/预览，不写飞书
# 0 = 真实写入飞书
# 第一次测试建议保持 1；确认无误后改成 0。
DRY_RUN=1
